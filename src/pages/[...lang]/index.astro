---
import Layout from '@/layouts/Layout.astro';
import HomeBody from '@/components/HomeBody.astro';
import { getLangStaticPaths, type Lang } from '@/i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const { lang } = Astro.props as { lang: Lang };
---

<Layout lang={lang} active="home" showSections={true}>
  <HomeBody lang={lang} />
</Layout>
