---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteNav from '@/components/SiteNav.astro';
import Hero from '@/components/sections/Hero.astro';
import Projects from '@/components/sections/Projects.astro';
import Experience from '@/components/sections/Experience.astro';
import About from '@/components/sections/About.astro';
import Contact from '@/components/sections/Contact.astro';
import { getLangStaticPaths, type Lang } from '@/i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const { lang } = Astro.props as { lang: Lang };
---

<Layout lang={lang}>
  <SiteHeader lang={lang} />
  <SiteNav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Experience lang={lang} />
    <About lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>

<script>
  import { initScrollReveal } from '@/scripts/scroll-reveal';
  initScrollReveal();

  // Entrada de lo que no pertenece a un stage (el hero) al aparecer en pantalla
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    },
    { threshold: 0.15 },
  );
  document.querySelectorAll('.reveal:not([data-stage] .reveal)').forEach((el) => io.observe(el));
</script>
