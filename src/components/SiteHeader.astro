---
import { placeholderNav } from '@/data/placeholder';
---

<header class="fixed inset-x-0 top-0 z-30 flex h-[60px] items-center justify-between px-4 md:h-[72px] md:px-10">
  <a href="#inicio" class="flex flex-col text-brand uppercase" aria-label="Martín Barreiro">
    <span class="font-serif text-[1.35rem] italic leading-[0.95] tracking-[-0.06em] md:text-[2rem]">Martín</span>
    <span class="text-[1.35rem] font-black leading-[0.85] tracking-[-0.05em] md:text-[2rem]">Barreiro</span>
  </a>
  <a
    href="#contacto"
    class="rounded-full bg-brand px-[18px] py-[11px] text-[11px] font-semibold uppercase tracking-[0.14em] text-paper md:px-5 md:text-xs md:tracking-[0.16em]"
  >
    {placeholderNav[4]}
  </a>
</header>
