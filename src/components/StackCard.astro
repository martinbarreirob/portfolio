---
import { getDictionary, type Lang } from '@/i18n/utils';
import { stack } from '@/data/stack';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="stack" class="card flex flex-col gap-5 p-6 lg:p-8">
  <h2 class="section-label">{t.home.stackTitle}</h2>

  <ul class="flex list-none flex-wrap gap-2.5 p-0">
    {
      stack.map((tech) => (
        <li class="pill">
          <i class={`${tech.icon} text-lg`} aria-hidden="true" />
          <span>{tech.name}</span>
        </li>
      ))
    }
  </ul>
</section>
