---
import { getDictionary, localizedPath, type Lang } from '@/i18n/utils';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const homeHref = localizedPath(lang, '');
const aboutHref = localizedPath(lang, 'about');

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isAbout = path.endsWith('/about');
const isHome = !isAbout;

const linkBase =
  'font-normal inline-block px-[18px] py-[3px] rounded-md border border-transparent transition-all duration-300 hover:border-neutral-300 hover:shadow-sm hover:-translate-y-[1px]';
const active = 'bg-neutral-200/60 border-neutral-300 shadow-sm';
---

<header class="fixed z-[1000] flex w-full max-w-[1300px] items-center justify-center">
  <div
    class="box-border flex w-full items-center justify-between rounded-[30px] bg-white/70 px-12 py-4 backdrop-blur-sm max-md:rounded-none max-md:px-4"
  >
    <a href={homeHref} class="flex items-center gap-2">
      <span class="block h-[15px] w-[15px] rounded-full bg-orange"></span>
      <span class="font-medium">MartinBarreiro</span>
    </a>

    <nav class="flex items-center gap-2 md:gap-8">
      <a href={homeHref} class={`${linkBase} ${isHome ? active : ''}`}>{t.nav.home}</a>
      <a href={aboutHref} class={`${linkBase} ${isAbout ? active : ''}`}>{t.nav.about}</a>
      <LanguageSwitcher lang={lang} />
    </nav>
  </div>
</header>
