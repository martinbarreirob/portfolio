---
import { languages, getDictionary, localizedPath, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Conserva la página actual (sin prefijo de idioma) al cambiar de idioma.
const path = Astro.url.pathname.replace(/\/$/, '');
const subpath = path.endsWith('/about') ? 'about' : '';
---

<div class="flex items-center gap-1">
  {
    languages.map((code) => (
      <a
        href={localizedPath(code, subpath)}
        aria-label={getDictionary(code).langName}
        class:list={[
          'rounded-pill px-2 py-1 text-xs font-semibold uppercase transition-colors',
          code === lang ? 'bg-accent text-accent-ink' : 'text-muted hover:text-text',
        ]}
      >
        {code}
      </a>
    ))
  }
</div>
