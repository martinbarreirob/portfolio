---
import { getDictionary, localizedPath, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
const aboutHref = localizedPath(lang, 'about');
---

<section
  class="flex flex-col gap-6 overflow-hidden rounded-card bg-accent p-7 text-accent-ink lg:p-9"
>
  <!-- Píldoras superiores -->
  <div class="flex items-center justify-between gap-3">
    <span
      class="inline-flex items-center gap-2 rounded-pill bg-accent-ink/10 px-3 py-1.5 text-xs font-semibold"
    >
      <i class="fa-regular fa-square"></i>{t.nav.about}
    </span>
    <span
      class="inline-flex items-center gap-2 rounded-pill bg-[var(--card)] px-3 py-1.5 text-xs font-semibold text-text"
    >
      <i class="fa-solid fa-circle text-[0.55em] text-[#3ea66b]"></i>{t.ui.openToWork}
    </span>
  </div>

  <!-- Retrato -->
  <div class="flex flex-1 items-center justify-center py-2">
    <div
      class="aspect-square w-40 overflow-hidden rounded-full border-2 border-accent-ink/15 lg:w-[236px]"
    >
      <img src="/assets/retrato.webp" alt={t.home.name} class="h-full w-full object-cover" />
    </div>
  </div>

  <!-- Nombre -->
  <div>
    <p class="text-lg font-medium opacity-70">{t.home.greeting}</p>
    <h2 class="text-[clamp(2.4rem,6vw,58px)] font-bold leading-[1.0]">{t.home.name}</h2>
  </div>

  <!-- Pie: rol + enlace a Sobre mí -->
  <div class="flex items-center justify-between gap-3 border-t border-accent-ink/15 pt-5">
    <span class="text-sm font-medium">{t.home.role}</span>
    <a
      href={aboutHref}
      class="inline-flex items-center gap-2 text-sm font-semibold transition-transform hover:translate-x-0.5"
    >
      {t.ui.viewAbout}<i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>
</section>
