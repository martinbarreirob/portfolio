---
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="contacto" class="card flex flex-col gap-5 p-6 lg:p-8">
  <h2 class="section-label">{t.contact.title}</h2>

  <div class="flex flex-wrap items-center gap-2.5">
    <a
      href="https://www.linkedin.com/in/martinbarreirob/"
      target="_blank"
      rel="noopener"
      class="pill transition-colors hover:bg-[#0A66C2] hover:text-white"
    >
      <i class="fab fa-linkedin text-lg"></i>{t.contact.linkedin}
    </a>
    <a
      href="https://github.com/martinbarreirob"
      target="_blank"
      rel="noopener"
      class="pill transition-colors hover:bg-[#6E5494] hover:text-white"
    >
      <i class="fab fa-github text-lg"></i>{t.contact.github}
    </a>
    <button
      type="button"
      data-copy-email
      data-email={t.contact.email}
      data-copied={t.ui.copied}
      class="pill transition-colors hover:bg-accent hover:text-accent-ink"
    >
      {t.contact.email}<i class="fa-solid fa-copy"></i>
    </button>
  </div>
</section>

<div
  id="snackbar"
  class="pointer-events-none fixed bottom-5 left-1/2 z-[1000] flex -translate-x-1/2 items-center rounded-lg bg-accent px-3 py-2 text-center text-sm text-accent-ink opacity-0 transition-opacity duration-500"
>
</div>

<script is:inline>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      const msg = btn.getAttribute('data-copied') || '';
      try {
        await navigator.clipboard.writeText(email);
        const snackbar = document.getElementById('snackbar');
        if (!snackbar) return;
        snackbar.textContent = msg;
        snackbar.style.opacity = '1';
        setTimeout(() => (snackbar.style.opacity = '0'), 4000);
      } catch (err) {
        console.error('Error al copiar al portapapeles:', err);
      }
    });
  });
</script>
