---
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="contacto" class="w-full">
  <h2 class="mx-4 mb-4 mt-12 font-medium italic">{t.contact.title}</h2>

  <div class="flex flex-col gap-4 rounded-[20px] bg-card p-6 shadow-soft md:p-12">
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="https://www.linkedin.com/in/martinbarreirob/"
        target="_blank"
        rel="noopener"
        class="chip cursor-pointer transition-colors hover:bg-linkedin hover:text-offwhite"
      >
        {t.contact.linkedin}<i class="fab fa-linkedin"></i>
      </a>
      <button
        type="button"
        data-copy-email
        data-email={t.contact.email}
        data-copied={t.contact.copied}
        class="chip cursor-pointer transition-colors hover:bg-ink hover:text-white"
      >
        {t.contact.email}<i class="fa-solid fa-copy"></i>
      </button>
    </div>
  </div>
</section>

<div
  id="snackbar"
  class="pointer-events-none fixed bottom-5 left-1/2 z-[1000] flex -translate-x-1/2 items-center justify-center rounded-lg bg-orange px-3 py-2 text-center text-[0.9em] text-offwhite opacity-0 shadow-chip transition-opacity duration-500"
>
</div>

<script is:inline>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      const msg = btn.getAttribute('data-copied') || '';
      try {
        await navigator.clipboard.writeText(email);
        const snackbar = document.getElementById('snackbar');
        if (!snackbar) return;
        snackbar.textContent = msg;
        snackbar.style.opacity = '1';
        setTimeout(() => (snackbar.style.opacity = '0'), 4000);
      } catch (err) {
        console.error('Error al copiar al portapapeles:', err);
      }
    });
  });
</script>
