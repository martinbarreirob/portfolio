---
import type { Lang } from '@/i18n/utils';
import PresentationCard from '@/components/PresentationCard.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import StackCard from '@/components/StackCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ContactCard from '@/components/ContactCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="bento">
  <div class="area-intro"><PresentationCard lang={lang} /></div>
  <div class="area-exp"><ExperienceCard lang={lang} /></div>
  <div class="area-stack"><StackCard lang={lang} /></div>
  <div class="area-proj"><ProjectCard lang={lang} /></div>
  <div class="area-contact"><ContactCard lang={lang} /></div>
</div>

<style>
  /* Móvil: una columna, orden natural de lectura */
  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  .bento > div {
    display: flex;
  }
  .bento > div > :global(*) {
    flex: 1;
  }

  /* Escritorio: rejilla bento de 4 columnas con áreas nombradas */
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        'intro intro exp exp'
        'intro intro exp exp'
        'stack stack proj proj'
        'contact contact proj proj';
    }
    .area-intro {
      grid-area: intro;
    }
    .area-exp {
      grid-area: exp;
    }
    .area-stack {
      grid-area: stack;
    }
    .area-proj {
      grid-area: proj;
    }
    .area-contact {
      grid-area: contact;
    }
  }
</style>
