---
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<div
  class="carousel relative flex max-h-[600px] flex-1 items-center justify-center overflow-hidden rounded-[13px] md:max-h-none"
  data-carousel
>
  {
    images.map((src, i) => (
      <img
        src={src}
        alt=""
        class:list={[
          'absolute inset-0 h-full w-full object-cover transition-opacity duration-700',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-slide
      />
    ))
  }
  <!-- imagen fantasma para dar altura al contenedor -->
  <img src={images[0]} alt="" class="invisible h-full w-full object-cover" aria-hidden="true" />
</div>

<script is:inline>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = carousel.querySelectorAll('[data-slide]');
    if (slides.length <= 1) return;
    let current = 0;
    setInterval(() => {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % slides.length;
      slides[current].classList.replace('opacity-0', 'opacity-100');
    }, 3000);
  });
</script>
