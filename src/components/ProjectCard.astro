---
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="proyectos" class="card flex flex-col gap-6 p-6 lg:p-8">
  <h2 class="section-label">{t.home.projectsTitle}</h2>

  {
    t.home.projects.map((project) => (
      <article class="flex flex-1 flex-col">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3">
          <h3 class="text-xl">{project.title}</h3>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener"
              aria-label={project.title}
              class="text-muted transition-colors hover:text-accent"
            >
              <i class="fa-solid fa-arrow-up-right-from-square" />
            </a>
          )}
        </div>
        <p class="mt-0.5 text-sm font-medium text-accent">{project.subtitle}</p>
        <div class="rich mt-2 text-sm" set:html={project.description} />

        <div class="mt-4 flex flex-wrap items-center gap-2">
          {project.technologies.map((tech) => (
            <span class="pill card-alt py-1.5 text-xs">{tech}</span>
          ))}
        </div>
      </article>
    ))
  }
</section>
