---
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);

// Resumen en una línea: rol + descripción sin etiquetas HTML.
const plain = (html: string) => html.replace(/<[^>]+>/g, '').trim();
---

<section id="experiencia" class="card flex flex-col gap-5 p-6 lg:p-7">
  <h2 class="section-label">{t.home.experienceTitle}</h2>

  <ol class="flex list-none flex-col gap-5 p-0">
    {
      t.home.experiences.map((job) => (
        <li class="flex items-start gap-3">
          <span class="exp-avatar" aria-hidden="true">
            {job.company.charAt(0)}
          </span>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="truncate text-base font-bold">{job.company}</h3>
              <span class="shrink-0 text-xs font-medium text-muted">{job.period}</span>
            </div>
            <p class="mt-0.5 truncate text-sm text-muted">
              <span class="font-medium text-accent">{job.role}</span>
              <span class="opacity-70"> · {plain(job.description)}</span>
            </p>
            {job.recommendation && (
              <a
                href={job.recommendation}
                target="_blank"
                rel="noopener"
                class="pill mt-2 py-1 text-xs text-accent transition-colors hover:bg-accent hover:text-accent-ink"
              >
                {t.ui.recommendation}
                <i class="fa-regular fa-envelope" />
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
