---
interface Props {
  empresa: string;
  puesto: string;
  data: string;
  description: string;
  technologies: string[];
  recomendation?: string;
  recommendationLabel: string;
}

const { empresa, puesto, data, description, technologies, recomendation, recommendationLabel } =
  Astro.props;
---

<article class="flex flex-col justify-between rounded-[20px] bg-card p-6 shadow-soft md:p-12">
  <div>
    <div class="text-[1.4em] font-semibold">{empresa}</div>
    <div class="mt-[5px] text-base font-normal">{puesto}</div>
    <div class="text-[0.8em] font-light">{data}</div>
    <div class="rich mt-4" set:html={description} />
  </div>

  <div class="mt-8 flex flex-row items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-[10px]">
      {technologies.map((tech) => <span class="chip">{tech}</span>)}
    </div>
    {
      recomendation && (
        <a href={recomendation} target="_blank" rel="noopener">
          <span class="chip cursor-pointer bg-orange text-offwhite transition-colors hover:bg-offwhite hover:text-ink">
            {recommendationLabel}
            <i class="fa-regular fa-envelope" />
          </span>
        </a>
      )
    }
  </div>
</article>
