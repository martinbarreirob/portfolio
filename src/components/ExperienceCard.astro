---
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="experiencia" class="card flex flex-col gap-6 p-6 lg:p-8">
  <h2 class="section-label">{t.home.experienceTitle}</h2>

  <ol class="flex list-none flex-col gap-6 p-0">
    {
      t.home.experiences.map((job) => (
        <li class="border-b border-[var(--card-border)] pb-6 last:border-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="text-xl">{job.company}</h3>
            <span class="text-xs font-medium text-muted">{job.period}</span>
          </div>
          <p class="mt-0.5 text-sm font-medium text-accent">{job.role}</p>
          <div class="rich mt-2 text-sm" set:html={job.description} />

          <div class="mt-4 flex flex-wrap items-center gap-2">
            {job.technologies.map((tech) => (
              <span class="pill card-alt py-1.5 text-xs">{tech}</span>
            ))}
            {job.recommendation && (
              <a
                href={job.recommendation}
                target="_blank"
                rel="noopener"
                class="pill py-1.5 text-xs text-accent transition-colors hover:bg-accent hover:text-accent-ink"
              >
                {t.ui.recommendation}
                <i class="fa-regular fa-envelope" />
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
