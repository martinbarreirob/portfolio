---
import { getDictionary, type Lang } from '@/i18n/utils';
import Carousel from '@/components/Carousel.astro';
import StudyCard from '@/components/StudyCard.astro';
import ContactCard from '@/components/ContactCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
const aboutImages = ['/assets/about1.webp', '/assets/about2.webp', '/assets/about3.webp'];
---

<div class="flex flex-col gap-4">
  <!-- Cabecera -->
  <section class="card flex flex-col gap-5 p-6 lg:p-8">
    <div class="flex items-center gap-4">
      <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full border border-[var(--card-border)]">
        <img src="/assets/selfie.webp" alt={t.footer.name} class="h-full w-full object-cover" />
      </div>
      <div>
        <h1 class="text-2xl lg:text-3xl">{t.footer.name}</h1>
        <span
          class="mt-1 inline-flex items-center gap-2 rounded-pill bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent-ink"
        >
          <i class="fa-solid fa-circle text-[0.6em]"></i>{t.ui.openToWork}
        </span>
      </div>
    </div>
    <div>
      <h2 class="text-lg font-semibold">{t.about.role}</h2>
      <p class="mt-1 text-muted">{t.about.tagline}</p>
    </div>
  </section>

  <!-- ¿Quién soy? -->
  <section class="card flex flex-col gap-0 overflow-hidden md:flex-row">
    <div class="md:w-1/2">
      <Carousel images={aboutImages} />
    </div>
    <div class="flex flex-1 flex-col gap-3 p-6 lg:p-8">
      <h2 class="section-label">{t.about.whoTitle}</h2>
      <div class="rich text-sm">
        {t.about.whoParagraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- Estudios -->
  <section class="flex flex-col gap-4">
    <h2 class="section-label px-2">{t.about.studiesTitle}</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {
        t.about.studies.map((study) => (
          <StudyCard
            title={study.title}
            center={study.center}
            period={study.period}
            description={study.description}
            technologies={study.technologies}
          />
        ))
      }
    </div>
  </section>

  <ContactCard lang={lang} />
</div>
