---
interface Props {
  title: string;
  center: string;
  period: string;
  description: string;
  technologies: string[];
}

const { title, center, period, description, technologies } = Astro.props;
---

<article class="card flex flex-col gap-3 p-6 lg:p-7">
  <div>
    <h3 class="text-lg">{title}</h3>
    <p class="mt-0.5 text-sm font-medium text-accent">{center}</p>
    <p class="text-xs text-muted">{period}</p>
  </div>
  <div class="rich text-sm" set:html={description} />
  <div class="mt-1 flex flex-wrap items-center gap-2">
    {technologies.map((tech) => <span class="pill card-alt py-1.5 text-xs">{tech}</span>)}
  </div>
</article>
