---
interface Props {
  title: string;
  center: string;
  data: string;
  description: string;
  technologies: string[];
}

const { title, center, data, description, technologies } = Astro.props;
---

<article class="flex flex-col justify-between rounded-[20px] bg-card p-6 shadow-soft md:p-12">
  <div>
    <div class="text-[1.4em] font-semibold">{title}</div>
    <div class="mt-[5px] text-base font-normal">{center}</div>
    <div class="text-[0.8em] font-light">{data}</div>
    <div class="rich mt-4" set:html={description} />
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-[10px]">
    {technologies.map((tech) => <span class="chip">{tech}</span>)}
  </div>
</article>
