---
import Screen from './Screen.astro';
import { placeholderContact as c } from '@/data/placeholder';

const field =
  'min-h-6 border-0 border-b border-ink/35 bg-transparent py-2.5 text-[15px] text-inherit outline-0 placeholder:text-ink/50 focus:border-brand';
---

<Screen id="contacto">
  <div class="screen-grid grid-contact">
    <div class="cell reveal justify-end gap-3 bg-brand p-[22px] text-paper md:gap-3.5 md:p-[26px]" style="grid-area:cta">
      <h2 class="text-[2.75rem] font-black leading-[0.95] tracking-[-0.05em] md:text-6xl">{c.title}</h2>
      <p class="font-serif text-lg italic leading-snug md:text-[21px]">{c.subtitle}</p>
      <a class="lk self-start border-b-2 border-current pb-1 text-base font-semibold md:text-[22px]" href="#">{c.email}</a>
    </div>
    <form class="cell reveal justify-end bg-card p-5 md:p-[26px]" style="grid-area:form;--i:1" onsubmit="return false">
      <input type="email" placeholder="Tu correo" class={field} />
      <input type="text" placeholder="Cuéntame el proyecto en una línea" class={field} />
      <button type="submit" class="mt-1.5 self-start rounded-full bg-brand px-[22px] py-[13px] text-[13px] font-semibold text-paper">Enviar</button>
    </form>
    <a class="cell lk reveal flex-row items-end justify-between bg-ink text-xl font-black leading-none tracking-[-0.04em] text-paper md:text-[28px]" style="grid-area:gh;--i:2" href="#">
      GitHub<span>↗</span>
    </a>
    <a class="cell lk reveal flex-row items-end justify-between bg-card text-xl font-black leading-none tracking-[-0.04em] text-brand md:text-[28px]" style="grid-area:li;--i:3" href="#">
      LinkedIn<span>↗</span>
    </a>
  </div>
</Screen>
