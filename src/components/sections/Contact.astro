---
import Screen from './Screen.astro';
import { placeholderContact as c } from '@/data/placeholder';
import { profile } from '@/data/profile';
import { getDictionary, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const t = getDictionary(Astro.props.lang);

const field =
  'min-h-6 border-0 border-b border-ink/35 bg-transparent py-2.5 text-[15px] md:text-[17px] text-inherit outline-0 placeholder:text-ink/50 focus:border-brand';
---

<Screen id="contacto">
  <div class="screen-grid grid-contact">
    <div class="cell reveal justify-end gap-3 bg-brand p-[26px] text-paper md:gap-3.5 md:p-[30px]" style="grid-area:cta" data-step="0">
      <h2 class="text-[2.75rem] font-black leading-[0.95] tracking-[-0.05em] md:text-6xl">{t.contact.title}</h2>
      <p class="font-serif text-lg italic leading-snug md:text-[21px]">{c.subtitle}</p>
      <a class="lk self-start break-all border-b-2 border-current pb-1 text-base font-semibold md:text-[22px]" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <form class="cell reveal justify-end bg-card p-6 md:p-[30px]" style="grid-area:form" data-step="1" onsubmit="return false">
      <input type="email" placeholder="Tu correo" class={field} />
      <input type="text" placeholder="Cuéntame el proyecto en una línea" class={field} />
      <button type="submit" class="mt-1.5 self-start rounded-full bg-brand px-[22px] py-[13px] text-[13px] md:text-[15px] font-semibold text-paper">Enviar</button>
    </form>
    <a class="cell lk reveal flex-row items-end justify-between bg-ink text-[clamp(1rem,5vw,1.25rem)] font-black leading-none tracking-[-0.04em] text-paper md:text-[clamp(1.125rem,2.6vw,1.75rem)]" style="grid-area:gh" data-step="1" href={profile.github.url} target="_blank" rel="noopener noreferrer">
      {profile.github.label}<span>↗</span>
    </a>
    <a class="cell lk reveal flex-row items-end justify-between bg-card text-[clamp(1rem,5vw,1.25rem)] font-black leading-none tracking-[-0.04em] text-brand md:text-[clamp(1.125rem,2.6vw,1.75rem)]" style="grid-area:li" data-step="1" href={profile.linkedin.url} target="_blank" rel="noopener noreferrer">
      {profile.linkedin.label}<span>↗</span>
    </a>
  </div>
</Screen>
